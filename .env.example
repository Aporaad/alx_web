# Portal read-only HTTP routes are hosted by SwiftShip /api/v1/portal.
# Keep disabled until the API server version containing those routes is deployed.
VITE_PORTAL_API_BASE_URL=http://localhost:3000
VITE_PORTAL_API_ENABLED=false
# Enables login, refresh, logout, profile and password changes through alx_api.
# Registration and profile/entity writes remain on Legacy until their API contracts exist.
VITE_PORTAL_AUTH_API_ENABLED=false
