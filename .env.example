# Base URL for the SwiftShip alx_api service.
VITE_PORTAL_API_BASE_URL=http://localhost:3000

# Legacy read-only Portal gateway; keep disabled until its routes are deployed.
VITE_PORTAL_API_ENABLED=false

# Portal API rollout flags. Keep false until the corresponding API is deployed,
# verified in a staging environment, and legacy account compatibility is confirmed.
VITE_PORTAL_AUTH_API_ENABLED=false
VITE_PORTAL_REGISTRATION_API_ENABLED=false
VITE_PORTAL_PROFILE_API_ENABLED=false
VITE_PORTAL_CUSTOMER_DETAILS_API_ENABLED=false
VITE_PORTAL_TICKETS_API_ENABLED=false
VITE_PORTAL_CUSTOMER_ORDERS_API_ENABLED=false
